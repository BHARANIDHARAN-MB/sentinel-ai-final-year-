# Copy this file to .env (in the sentinel-ai root folder, next to
# report_service.py) and fill in real values. Never commit .env itself.

# Enables real LLM-written report narratives and real AI chat replies
# (both fall back to safe template/rule-based responses without this,
# which is why the assistant said "offline mode" - it wasn't a bug, it
# just had no key to work with).
#
# Get a free key at https://console.groq.com/keys (no billing setup
# required for the free tier, unlike some other providers).
GROQ_API_KEY=
