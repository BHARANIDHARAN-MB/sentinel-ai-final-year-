# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string - use your existing Atlas cluster (the same one
# from Nexus AI works fine, just point it at a new database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel-ai

# Any long random string - used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Email delivery for OTP codes ---
# Checked in this order: Gmail first, then Resend, then console fallback.
# You only need to fill in ONE of the two options below.

# OPTION A: Gmail SMTP - works with ANY recipient email address, no domain
# needed. This is the practical choice if you don't own a domain.
#   1. Go to myaccount.google.com/security
#   2. Turn on "2-Step Verification" if it isn't already on (required)
#   3. Search for "App Passwords" (or go to myaccount.google.com/apppasswords)
#   4. Create one named "Sentinel AI", copy the 16-character password it gives you
#   5. Paste your Gmail address and that app password below (NOT your normal
#      Gmail password - app passwords are separate and revocable)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OPTION B: Resend API key (resend.com). Only used if GMAIL_USER above is
# blank. Their shared onboarding@resend.dev sender can ONLY deliver to the
# email address that owns your Resend account - real arbitrary-recipient
# delivery requires verifying your own domain in their dashboard.
RESEND_API_KEY=
FROM_EMAIL=Sentinel AI <onboarding@resend.dev>

# If NEITHER option above is filled in, OTPs print to the server console
# instead of emailing - fine for local development, NEVER acceptable in
# production (anyone with server log access could log in as anyone).

PORT=8009
